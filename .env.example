# Server-side only. Do not put secrets in a VITE_* variable.
SPTRANS_TOKEN=
SPTRANS_COMPANY_ID=
PATIO_AREA_FILE=
PATIO_REPLAY_FILE=
PATIO_REPLAY_KEY=

# Compose mounts ./runtime-data read-only at /run/patio.
# SPTRANS_TOKEN_FILE=/run/patio/sptrans-token.txt
# PATIO_AREA_FILE=/run/patio/area.json
# PATIO_PUBLIC_ORIGIN=http://127.0.0.1:8080

# IA local e gravação anotada no volume runtime-data.
# PATIO_LLM_MODEL_PATH=/run/patio/qwen.gguf
# PATIO_VISION_DIR=/run/patio/vision

# Fonte opcional de LIVE sem credencial, com observações do BRT do Rio.
# PATIO_LIVE_PROVIDER=rio_brt
